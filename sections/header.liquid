{%- liquid
  comment
    Strip a single trailing slash without touching the "//" in the scheme:
    tack on a sentinel, collapse "/<sentinel>", then drop the sentinel.
  endcomment
  assign base_url = section.settings.museum_url | default: 'https://thealdrich.org' | strip
  assign base_url = base_url | append: '~' | replace: '/~', '' | replace: '~', ''

  assign menu = linklists[section.settings.main_linklist]
  assign shop_menu = linklists[section.settings.shop_linklist]
-%}

<style>
  {%- if section.settings.sticky -%}
    .section__header {
      position: sticky;
      z-index: 550;
      top: 0;
    }
  {%- else -%}
    .section__header {
      position: relative;
      z-index: 550;
    }
  {%- endif -%}

  [data-section-id="{{ section.id }}"] {
    --aldrich-logo-width: {{ section.settings.logo_width }}px;
    --aldrich-logo-mobile-width: {{ section.settings.logo_mobile_width }}px;
  }
</style>

<div class="aldrich-header{% if request.page_type == 'index' %} aldrich-header--home{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="header"
  data-aldrich-header>

  <div class="aldrich-header__utility-bar">
    <div class="aldrich-container">
      {%- render 'aldrich-utility-links', section: section, variant: 'bar' -%}
    </div>
  </div>

  <div class="aldrich-container">
    <div class="aldrich-header__bar">
      <button type="button"
        class="aldrich-header__toggle"
        aria-expanded="false"
        aria-controls="AldrichHeaderMenu"
        data-aldrich-menu-toggle>
        <span class="aldrich-header__hamburger" aria-hidden="true">
          <span class="aldrich-header__hamburger-inner"></span>
        </span>
        <span class="aldrich-visually-hidden">{{ 'sections.header.menu' | t }}</span>
      </button>

      {%- capture logo_content -%}
        {%- if section.settings.logo != blank -%}
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
          {{ section.settings.logo | image_url: width: 1200 | image_tag:
            class: 'aldrich-header__logo-image',
            widths: '200, 300, 400, 600, 900, 1200',
            alt: logo_alt,
            preload: true }}
        {%- else -%}
          <span class="aldrich-header__logo-mark aldrich-header__logo-mark--small" aria-hidden="true">
            {{- 'aldrich-logo-small.svg' | inline_asset_content -}}
          </span>
          <span class="aldrich-header__logo-mark aldrich-header__logo-mark--large" aria-hidden="true">
            {{- 'aldrich-logo-large.svg' | inline_asset_content -}}
          </span>
        {%- endif -%}
        {%- if section.settings.badge_text != blank -%}
          <span class="aldrich-header__badge">{{ section.settings.badge_text | escape }}</span>
        {%- endif -%}
        <span class="aldrich-visually-hidden">{{ shop.name }}</span>
      {%- endcapture -%}

      {%- if request.page_type == 'index' -%}
        <h1 class="aldrich-header__logo">
          <a class="aldrich-header__logo-link" href="{{ routes.root_url }}">{{ logo_content }}</a>
        </h1>
      {%- else -%}
        <div class="aldrich-header__logo">
          <a class="aldrich-header__logo-link" href="{{ routes.root_url }}">{{ logo_content }}</a>
        </div>
      {%- endif -%}

      <div class="aldrich-header__menu" id="AldrichHeaderMenu">
        <nav class="aldrich-header__nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}">
          <ul class="aldrich-nav" role="list">
            {%- if section.settings.menu_source == 'menu' and menu != blank -%}
              {%- render 'aldrich-nav-menu', menu: menu, id_prefix: 'AldrichNav' -%}
            {%- else -%}
              {%- render 'aldrich-nav-default', base_url: base_url, shop_menu: shop_menu -%}
            {%- endif -%}
          </ul>
        </nav>

        <div class="aldrich-header__utility-menu">
          {%- render 'aldrich-utility-links', section: section, variant: 'menu' -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo %}
      "logo": {{ section.settings.logo | image_url: width: section.settings.logo.width | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_url | json }},
      {{ settings.social_facebook_url | json }},
      {{ settings.social_pinterest_url | json }},
      {{ settings.social_instagram_url | json }},
      {{ settings.social_tiktok_url | json }},
      {{ settings.social_youtube_url | json }}
    ],
    "url": {{ shop.url | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {%- assign potential_action_target = shop.url | append: routes.search_url | append: "?q={search_term_string}" -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ shop.url | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% stylesheet %}
  /* Layout primitives mirroring the main site's Bootstrap container */
  .aldrich-container {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    padding-right: 16px;
    padding-left: 16px;
  }

  @media (min-width: 576px) {
    .aldrich-container { max-width: 768px; }
  }

  @media (min-width: 768px) {
    .aldrich-container { max-width: 1024px; }
  }

  @media (min-width: 1024px) {
    .aldrich-container { max-width: 1280px; }
  }

  @media (min-width: 1280px) {
    .aldrich-container { max-width: 1281px; }
  }

  .aldrich-visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .aldrich-header {
    position: relative;
    background: var(--aldrich-background);
    color: var(--aldrich-body);
    font-family: var(--aldrich-sans);
    line-height: 1;
    font-weight: 400;
  }

  .aldrich-header a {
    color: var(--aldrich-body);
    text-decoration: none;
  }

  /* Utility bar ----------------------------------------------------------- */
  .aldrich-utility {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--aldrich-mono);
    color: var(--aldrich-body);
    font-weight: 400;
  }

  .aldrich-utility__link--highlight {
    background: var(--aldrich-highlight);
    padding: 3px 8px;
  }

  .aldrich-utility__item--cart {
    position: relative;
  }

  .aldrich-utility__item--cart .icon,
  .aldrich-utility__item--cart .cart-button__total {
    display: none;
  }

  .aldrich-utility__cart {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
  }

  .aldrich-utility__cart .cart-button__label { order: 1; }
  .aldrich-utility__cart .cart-button__count { order: 2; }
  .aldrich-utility__cart .cart-button__count::before { content: "("; }
  .aldrich-utility__cart .cart-button__count::after { content: ")"; }

  /* Search field, matching the main site's small Bootstrap control */
  .aldrich-search {
    position: relative;
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
  }

  /* Self-contained on purpose: the footer defines its own .aldrich-field for the
     sign-up form, and the order the two section stylesheets are combined in is
     not guaranteed. Two classes deep so it beats the theme's global
     [type="search"] and input[type="search"] rules. */
  .aldrich-search .aldrich-search__input {
    display: block;
    width: 100%;
    max-width: 220px;
    height: calc(1.5em + 0.5rem + 2px);
    padding: 0.25rem 2rem 0.25rem 0.5rem;
    font-family: var(--aldrich-mono);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--aldrich-field-ink);
    background-color: #fff;
    background-clip: padding-box;
    border: 1px solid var(--aldrich-field-border);
    border-radius: 0.2rem;
    box-shadow: none;
    transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
  }

  .aldrich-search .aldrich-search__input:focus {
    border-color: hsl(0, 0%, 25%);
    outline: 0;
    box-shadow: 0 0 0 0.2rem rgba(0, 0, 0, 0.25);
  }

  /* The theme uppercases bare labels in the navigation font. */
  .aldrich-utility label {
    text-transform: none;
    letter-spacing: normal;
  }

  .aldrich-search__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--aldrich-body);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .aldrich-search__submit .icon,
  .aldrich-search__icon {
    display: block;
    width: 1rem;
    height: 1rem;
  }

  .aldrich-search__clear {
    position: absolute;
    right: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    color: #3f6fae;
    background: transparent;
    border: 0;
    appearance: none;
    cursor: pointer;
  }

  .aldrich-search__clear[hidden] { display: none; }

  .aldrich-search__clear-icon {
    width: 0.75rem;
    height: 0.75rem;
  }

  /* Utility bar — mobile: stacked and centred inside the menu overlay */
  .aldrich-header__utility-bar {
    display: none;
  }

  .aldrich-utility--menu {
    text-align: center;
    font-size: 1rem;
    line-height: 1.4;
  }

  .aldrich-utility--menu .aldrich-utility__item {
    margin-bottom: 10px;
  }

  .aldrich-utility--menu .aldrich-search {
    justify-content: center;
    margin-top: 15px;
  }

  @media (min-width: 768px) {
    .aldrich-header__utility-bar { display: block; }

    .aldrich-header__utility-menu { display: none; }

    .aldrich-utility--bar {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      font-size: 0.75rem;
      text-align: right;
    }

    .aldrich-utility--bar .aldrich-utility__item {
      margin-top: 10px;
      padding-right: 16px;
    }

    .aldrich-utility--bar .aldrich-utility__item--search {
      padding-right: 0;
    }
  }

  /* The main site hides the opening hours in this range in both the top bar and
     the mobile menu, so the rule is deliberately not scoped to one variant. */
  @media (min-width: 576px) and (max-width: 910px) {
    .aldrich-utility__item--optional { display: none; }
  }

  /* Logo ------------------------------------------------------------------ */
  .aldrich-header__bar {
    display: flex;
    align-items: center;
    padding-top: 3px;
  }

  .aldrich-header__logo {
    z-index: 4;
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }

  .aldrich-header__logo-link {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .aldrich-header__logo-mark svg,
  .aldrich-header__logo-image {
    display: block;
    width: var(--aldrich-logo-mobile-width);
    height: auto;
  }

  .aldrich-header__logo-mark--large { display: none; }

  .aldrich-header__badge {
    display: inline-block;
    padding: 0.15em 0.4em;
    background: var(--aldrich-highlight);
    color: var(--aldrich-ink);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: var(--aldrich-tracking);
    text-transform: uppercase;
    line-height: 1.1;
  }

  @media (max-width: 767.98px) {
    /* Block layout, not flex, so the menu falls below the logo row the way the
       main site's wrapping navbar does. */
    .aldrich-header__bar {
      display: block;
      position: relative;
      min-height: 56px;
    }

    .aldrich-header__logo {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* The live site uses its compact wordmark and offsets it slightly right
       so it stays visually centred against the left-aligned hamburger. */
    .aldrich-header__logo-mark--small { display: block; }
    .aldrich-header__logo-mark--large { display: none; }
    .aldrich-header__logo-mark--small,
    .aldrich-header__logo-image {
      position: relative;
      left: 24px;
    }
  }

  @media (min-width: 768px) {
    .aldrich-header__bar {
      align-items: flex-end;
      margin-top: 10px;
      padding-top: 0;
    }

    .aldrich-header {
      padding-bottom: 8px;
    }

    .aldrich-header__logo-mark--small { display: none; }
    .aldrich-header__logo-mark--large { display: block; }

    .aldrich-header__logo-mark svg,
    .aldrich-header__logo-image {
      width: var(--aldrich-logo-width);
    }

    .aldrich-header__badge { font-size: 1.75rem; }
  }

  /* Hamburger ------------------------------------------------------------- */
  .aldrich-header__toggle {
    /* Occupies the full 56px logo row, so the in-flow menu below it starts
       clear of the absolutely positioned logo. scale() shrinks the bars
       visually without changing that layout height. */
    display: flex;
    align-items: center;
    height: 56px;
    position: relative;
    left: -15px;
    z-index: 5;
    padding: 10px;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    transform: scale(0.7);
  }

  .aldrich-header__hamburger {
    position: relative;
    display: block;
    width: 40px;
    height: 24px;
  }

  .aldrich-header__hamburger-inner,
  .aldrich-header__hamburger-inner::before,
  .aldrich-header__hamburger-inner::after {
    position: absolute;
    display: block;
    width: 40px;
    height: 4px;
    background-color: var(--aldrich-ink);
  }

  .aldrich-header__hamburger-inner {
    top: auto;
    bottom: 0;
    margin-top: 0;
    transition-delay: 0.13s;
    transition-timing-function: cubic-bezier(0.55, 0.055, 0.675, 0.19);
    transition-duration: 0.13s;
  }

  .aldrich-header__hamburger-inner::before {
    content: "";
    top: -10px;
    transition: top 0.12s cubic-bezier(0.33333, 0.66667, 0.66667, 1) 0.2s,
      transform 0.13s cubic-bezier(0.55, 0.055, 0.675, 0.19);
  }

  .aldrich-header__hamburger-inner::after {
    content: "";
    top: -20px;
    bottom: auto;
    transition: top 0.2s cubic-bezier(0.33333, 0.66667, 0.66667, 1) 0.2s,
      opacity 0.1s linear;
  }

  .aldrich-header--menu-open .aldrich-header__hamburger-inner {
    transition-delay: 0.22s;
    transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
    transform: translate3d(0, -10px, 0) rotate(-45deg);
  }

  .aldrich-header--menu-open .aldrich-header__hamburger-inner::before {
    top: 0;
    transition: top 0.1s cubic-bezier(0.33333, 0, 0.66667, 0.33333) 0.16s,
      transform 0.13s cubic-bezier(0.215, 0.61, 0.355, 1) 0.25s;
    transform: rotate(-90deg);
  }

  .aldrich-header--menu-open .aldrich-header__hamburger-inner::after {
    top: 0;
    opacity: 0;
    transition: top 0.2s cubic-bezier(0.33333, 0, 0.66667, 0.33333),
      opacity 0.1s linear 0.22s;
  }

  @media (min-width: 768px) {
    .aldrich-header__toggle { display: none; }
  }

  /* Navigation ------------------------------------------------------------ */
  .aldrich-nav {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aldrich-nav__item {
    font-family: var(--aldrich-nav);
    font-weight: 400;
    letter-spacing: var(--aldrich-tracking);
  }

  .aldrich-header .aldrich-nav__link {
    display: block;
    padding: 0.5rem 0 0;
    margin: 0;
    font: inherit;
    color: rgba(0, 0, 0, 0.5);
    text-align: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* Match Bootstrap's navbar-light states used on the main site. */
  .aldrich-header .aldrich-nav__item--current > .aldrich-nav__link,
  .aldrich-header .aldrich-nav__sublink.aldrich-nav__sublink--current {
    color: rgba(0, 0, 0, 0.9);
  }

  /* On the main site's homepage the entire primary navigation is dark. */
  .aldrich-header--home .aldrich-nav__link {
    color: rgba(0, 0, 0, 0.9);
  }

  .aldrich-header .aldrich-nav__link:hover,
  .aldrich-header .aldrich-nav__link:focus-visible,
  .aldrich-header .aldrich-nav__link[aria-expanded="true"],
  .aldrich-header .aldrich-nav__sublink:hover,
  .aldrich-header .aldrich-nav__sublink:focus-visible {
    color: rgba(0, 0, 0, 0.7);
  }

  .aldrich-nav__dropdown {
    font-family: var(--aldrich-sans);
    font-weight: 400;
    letter-spacing: var(--aldrich-tracking);
    background: var(--aldrich-background);
  }

  .aldrich-header .aldrich-nav__sublink {
    display: block;
    width: 100%;
    padding-bottom: 4px;
    color: rgb(33, 37, 41);
    white-space: nowrap;
  }

  .aldrich-nav__sublink--nested { padding-left: 26px; }

  /* Mobile: the menu expands in normal flow, matching the main site's wrapping
     navbar. A fixed overlay would sit on top of the callout bar and the logo
     instead of below them. */
  @media (max-width: 767.98px) {
    .aldrich-header__menu {
      display: none;
      width: 100%;
      min-height: 100vh;
      padding: 0 10px 50px;
      background: var(--aldrich-background);
    }

    .aldrich-header--menu-open .aldrich-header__menu { display: block; }

    .aldrich-nav {
      text-align: center;
      padding-bottom: 20px;
    }

    .aldrich-nav__item {
      font-size: 26px;
      padding-top: 10px;
    }

    .aldrich-nav__link {
      width: 100%;
      text-align: center;
    }

    .aldrich-nav__dropdown { font-size: 20px; }

    .aldrich-nav__sublink {
      padding-top: 10px;
      text-align: center;
      white-space: normal;
    }
  }

  /* Desktop: inline nav with absolutely positioned dropdowns */
  @media (min-width: 768px) {
    .aldrich-header__menu {
      flex: 1 1 auto;
      align-self: flex-end;
    }

    .aldrich-nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .aldrich-nav__item {
      position: relative;
      font-size: 20px;
    }

    .aldrich-header .aldrich-nav__link {
      padding: 0.5rem 0 0 1em;
    }

    .aldrich-nav__dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 1000;
      float: left;
      min-width: 10rem;
      margin: 0.125rem 0 0 8px;
      padding: 0.5rem 0 13px;
      font-size: 20px;
      text-align: left;
      border: none;
      border-radius: 0;
    }

    .aldrich-nav__dropdown--right {
      right: 0;
      left: auto;
    }

    .aldrich-nav__sublink {
      padding: 10px 13px 4px;
    }

    .aldrich-nav__sublink:hover { font-weight: 400; }
  }

{% endstylesheet %}

{% javascript %}
  (function () {
    var HEADER = '[data-aldrich-header]';
    var OPEN_CLASS = 'aldrich-header--menu-open';

    function closeDropdowns(root, except) {
      root.querySelectorAll('[data-aldrich-dropdown]').forEach(function (button) {
        if (button === except) return;
        button.setAttribute('aria-expanded', 'false');
        var panel = document.getElementById(button.getAttribute('aria-controls'));
        if (panel) panel.hidden = true;
      });
    }

    function closeMenu(header) {
      header.classList.remove(OPEN_CLASS);
      var toggle = header.querySelector('[data-aldrich-menu-toggle]');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    }

    document.addEventListener('click', function (event) {
      var header = event.target.closest ? event.target.closest(HEADER) : null;

      // A click anywhere outside a header collapses whatever it had open.
      if (!header) {
        document.querySelectorAll(HEADER).forEach(function (element) {
          closeDropdowns(element);
        });
        return;
      }

      var toggle = event.target.closest('[data-aldrich-menu-toggle]');
      if (toggle) {
        event.preventDefault();
        var isOpen = header.classList.toggle(OPEN_CLASS);
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (!isOpen) closeDropdowns(header);
        return;
      }

      var dropdown = event.target.closest('[data-aldrich-dropdown]');
      if (dropdown) {
        event.preventDefault();
        var panel = document.getElementById(dropdown.getAttribute('aria-controls'));
        var willOpen = dropdown.getAttribute('aria-expanded') !== 'true';
        closeDropdowns(header, dropdown);
        dropdown.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        if (panel) panel.hidden = !willOpen;
        return;
      }

      // Clicks inside the header but outside any dropdown close them all.
      if (!event.target.closest('.aldrich-nav__dropdown')) {
        closeDropdowns(header);
      }
    });

    document.addEventListener('keyup', function (event) {
      if (event.key !== 'Escape') return;
      document.querySelectorAll(HEADER).forEach(function (header) {
        closeDropdowns(header);
        closeMenu(header);
      });
    });

    document.addEventListener('input', function (event) {
      var input = event.target.closest ? event.target.closest('[data-aldrich-search-input]') : null;
      if (!input) return;
      var clear = input.parentNode.querySelector('[data-aldrich-search-clear]');
      if (clear) clear.hidden = input.value.length === 0;
    });

    function updateSearchClearButtons(root) {
      root.querySelectorAll('[data-aldrich-search-input]').forEach(function (input) {
        var clear = input.parentNode.querySelector('[data-aldrich-search-clear]');
        if (clear) clear.hidden = input.value.length === 0;
      });
    }

    /* The search term can be restored by the browser before an input event is
       emitted, so determine the initial clear-button state from the rendered
       field value as well as from subsequent typing. */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        updateSearchClearButtons(document);
      });
    } else {
      updateSearchClearButtons(document);
    }

    document.addEventListener('click', function (event) {
      var clear = event.target.closest ? event.target.closest('[data-aldrich-search-clear]') : null;
      if (!clear) return;
      var form = clear.closest('.aldrich-search');
      var input = form && form.querySelector('[data-aldrich-search-input]');
      if (!input) return;
      event.preventDefault();
      input.value = '';
      clear.hidden = true;
      input.focus();
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth < 768) return;
      document.querySelectorAll('.' + OPEN_CLASS).forEach(function (header) {
        closeMenu(header);
      });
    });
  })();
{% endjavascript %}

