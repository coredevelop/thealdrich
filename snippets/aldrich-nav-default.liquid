  <div class="aldrich-nav__dropdown aldrich-nav__dropdown--right" id="AldrichNavAbout" hidden>
    <a class="aldrich-nav__sublink" href="{{ base_url }}/about">{{ 'sections.aldrich_header.nav_overview' | t }}</a>
    <a class="aldrich-nav__sublink" href="{{ base_url }}/about#board-of-trustees">{{ 'sections.aldrich_header.nav_about_trustees' | t }}</a>
    <a class="aldrich-nav__sublink" href="{{ base_url }}/about#the-team">{{ 'sections.aldrich_header.nav_about_team' | t }}</a>
    <a class="aldrich-nav__sublink" href="{{ base_url }}/about#host-event">{{ 'sections.aldrich_header.nav_about_host_event' | t }}</a>
  </div>
</li>
