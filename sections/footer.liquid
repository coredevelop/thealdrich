{%- liquid
  assign locale_selector = false
  assign currency_selector = false

  if shop.enabled_currencies.size > 1 and section.settings.show_currency_selector
    assign currency_selector = true
  endif

  if shop.published_locales.size > 1 and section.settings.show_locale_selector
    assign locale_selector = true
  endif

  if locale_selector or currency_selector
    assign show_disclosures = true
  endif

  if section.settings.show_payment_icons and shop.enabled_payment_types != empty
    assign show_payment_icons = true
  endif
-%}

<style>
  {%- comment -%}
    The body picks up the footer's background so any overscroll area matches it,
    the way the main site's #fafafa page background does. Page content keeps the
    theme's own background.
  {%- endcomment -%}
  body {
    --section-background-color: #fafafa;
  }
  #MainContent {
    --section-background-color: {{ settings.general_background_color }};
  }
</style>

<div class="aldrich-footer"
  data-section-id="{{ section.id }}"
  data-section-type="footer">
  <div class="aldrich-container">
    <div class="aldrich-footer__columns">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'address' -%}
            <div class="aldrich-footer__col aldrich-footer__col--address" {{ block.shopify_attributes }}>
              {%- if block.settings.address != blank -%}
                <address class="aldrich-footer__address">{{ block.settings.address }}</address>
              {%- endif -%}
              {%- if block.settings.show_chevron -%}
                <span class="aldrich-footer__chevron" aria-hidden="true">
                  {{- 'aldrich-chevron.svg' | inline_asset_content -}}
                </span>
              {%- endif -%}
            </div>

          {%- when 'social' -%}
            <div class="aldrich-footer__col aldrich-footer__col--social" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="aldrich-footer__heading"><strong>{{ block.settings.title | escape }}</strong></h2>
              {%- endif -%}
              <p class="aldrich-footer__stack">
                {%- if settings.social_instagram_url != blank -%}
                  <a href="{{ settings.social_instagram_url }}" target="_blank" rel="noopener">Instagram</a><br>
                {%- endif -%}
                {%- if settings.social_facebook_url != blank -%}
                  <a href="{{ settings.social_facebook_url }}" target="_blank" rel="noopener">Facebook</a><br>
                {%- endif -%}
                {%- if settings.social_youtube_url != blank -%}
                  <a href="{{ settings.social_youtube_url }}" target="_blank" rel="noopener">YouTube</a><br>
                {%- endif -%}
                {%- if settings.social_twitter_url != blank -%}
                  <a href="{{ settings.social_twitter_url }}" target="_blank" rel="noopener">Twitter</a><br>
                {%- endif -%}
                {%- if settings.social_tiktok_url != blank -%}
                  <a href="{{ settings.social_tiktok_url }}" target="_blank" rel="noopener">TikTok</a><br>
                {%- endif -%}
                {%- if settings.social_pinterest_url != blank -%}
                  <a href="{{ settings.social_pinterest_url }}" target="_blank" rel="noopener">Pinterest</a><br>
                {%- endif -%}
                {%- if settings.social_linkedin_url != blank -%}
                  <a href="{{ settings.social_linkedin_url }}" target="_blank" rel="noopener">LinkedIn</a><br>
                {%- endif -%}
              </p>
            </div>

          {%- when 'menu' -%}
            {%- assign menu = linklists[block.settings.footer_linklist] -%}
            <div class="aldrich-footer__col aldrich-footer__col--menu"
              role="navigation"
              aria-label="{{ block.settings.title | default: menu.title | escape }}"
              {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="aldrich-footer__heading"><strong>{{ block.settings.title | escape }}</strong></h2>
              {%- endif -%}
              {%- if menu != blank -%}
                <p class="aldrich-footer__stack">
                  {%- for link in menu.links -%}
                    <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a><br>
                  {%- endfor -%}
                </p>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            {%- liquid
              assign form_id = 'AldrichNewsletter-' | append: section.id
              assign mailchimp_action = block.settings.mailchimp_action | strip
            -%}
            <div class="aldrich-footer__col aldrich-footer__col--newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="aldrich-footer__heading" id="aldrich-mailing-list"><strong>{{ block.settings.title | escape }}</strong></h2>
              {%- endif -%}
              {%- if block.settings.text_richtext != blank -%}
                <div class="aldrich-footer__newsletter-text">{{ block.settings.text_richtext }}</div>
              {%- endif -%}

              {%- if mailchimp_action != blank -%}
                {%- comment -%}
                  Posts to the museum's Mailchimp list, like thealdrich.org. The
                  main site submits its form over JSONP and prints Mailchimp's
                  reply in place, so `target` never actually gets used; it is
                  kept here as the no-JavaScript fallback.
                {%- endcomment -%}
                <form class="aldrich-form aldrich-footer__form"
                  id="{{ form_id }}"
                  action="{{ mailchimp_action }}"
                  method="get"
                  target="_blank"
                  novalidate
                  data-aldrich-newsletter
                  data-message-invalid="{{ 'newsletter.error' | t | escape }}">

                  <div class="aldrich-form__group">
                    <label for="{{ form_id }}-first">{{ 'customer.register.first_name' | t }}</label>
                    <input type="text"
                      class="aldrich-field"
                      id="{{ form_id }}-first"
                      name="FNAME"
                      autocomplete="given-name">
                  </div>

                  <div class="aldrich-form__group">
                    <label for="{{ form_id }}-last">{{ 'customer.register.last_name' | t }}</label>
                    <input type="text"
                      class="aldrich-field"
                      id="{{ form_id }}-last"
                      name="LNAME"
                      autocomplete="family-name">
                  </div>

                  <div class="aldrich-form__group">
                    <label for="{{ form_id }}-email">{{ 'sections.aldrich_footer.newsletter_email_label' | t }}</label>
                    <input type="email"
                      class="aldrich-field"
                      id="{{ form_id }}-email"
                      name="EMAIL"
                      autocomplete="email"
                      autocorrect="off"
                      autocapitalize="off"
                      aria-required="true"
                      required
                      data-aldrich-newsletter-email>
                  </div>

                  {%- if block.settings.mailchimp_honeypot != blank -%}
                    {%- comment -%}Mailchimp's bot trap: real people leave it empty.{%- endcomment -%}
                    <div class="aldrich-form__honeypot" aria-hidden="true">
                      <input type="text" name="{{ block.settings.mailchimp_honeypot | strip }}" tabindex="-1" value="">
                    </div>
                  {%- endif -%}

                  <div class="aldrich-form__message"
                    role="status"
                    aria-live="polite"
                    data-aldrich-newsletter-message></div>

                  <button type="submit" class="aldrich-button">{{ block.settings.button_label | default: "I'm in" | escape }}</button>
                </form>
              {%- endif -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    <hr class="aldrich-rule aldrich-rule--thin aldrich-footer__rule">

    {%- if section.settings.legal_label != blank or section.settings.show_policy_links -%}
      <div class="aldrich-footer__row">
        <ul class="aldrich-footer__inline" role="list">
          {%- if section.settings.legal_label != blank -%}
            <li>
              <a href="{{ section.settings.legal_url | default: '#' }}">{{ section.settings.legal_label | escape }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.show_policy_links -%}
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if show_disclosures or show_payment_icons -%}
      <div class="aldrich-footer__row aldrich-footer__row--store">
        {%- if show_disclosures -%}
          <div class="aldrich-footer__disclosures no-js-hidden">
            {%- if locale_selector -%}
              <disclosure-form class="disclosure">
                {%- form 'localization', id: 'FooterLanguageForm', class: 'header-top__selectors-form', data-form-submit-form: '' -%}
                  <span class="sr-only" id="FooterLanguageLabel">{{ 'localization.language_label' | t }}</span>
                  <button type="button"
                    class="disclosure__button"
                    aria-controls="FooterLanguageList"
                    aria-describedby="FooterLanguageLabel"
                    aria-expanded="false"
                    data-accordion-button
                    data-accordion-level="1">
                    <span class="px-1">{{ localization.language.endonym_name | capitalize }}</span>
                    {% render 'icon-ui-chevron-down' %}
                  </button>
                  <ul id="FooterLanguageList" role="list" class="disclosure__list"
                    hidden
                    data-accordion-panel
                    data-accordion-level="1">
                    {%- for language in localization.available_languages -%}
                      <li class="disclosure__item{% if language.iso_code == localization.language.iso_code %} disclosure__item--current{% endif %}">
                        <a href="#" class="disclosure__link {% if language.iso_code == localization.language.iso_code %}disclosure__link--current{% endif %}"{% if language.iso_code == localization.language.iso_code %} aria-current="true"{% endif %}
                          hreflang="{{ language.iso_code }}"
                          lang="{{ language.iso_code }}"
                          data-value="{{ language.iso_code }}"
                          data-form-submit-item>{{ language.endonym_name | capitalize }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                  <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}" data-form-submit-input />
                {%- endform -%}
              </disclosure-form>
            {%- endif -%}

            {%- if currency_selector -%}
              <disclosure-form class="disclosure">
                {%- form 'localization', id: 'FooterCurrencyForm', class: 'header-top__selectors-form', data-form-submit-form: '' -%}
                  <span class="sr-only" id="FooterCurrencyLabel">{{ 'localization.country_label' | t }}</span>
                  <button type="button"
                    class="disclosure__button"
                    aria-controls="FooterCurrencyList"
                    aria-describedby="FooterCurrencyLabel"
                    aria-expanded="false"
                    data-accordion-button
                    data-accordion-level="1">
                    <span class="px-1">{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})</span>
                    {% render 'icon-ui-chevron-down' %}
                  </button>
                  <ul id="FooterCurrencyList" role="list" class="disclosure__list"
                    hidden
                    data-accordion-panel
                    data-accordion-level="1">
                    {%- for country in localization.available_countries -%}
                      <li class="disclosure__item" tabindex="-1">
                        <a href="#" class="link link--text disclosure__link {% if country.iso_code == localization.country.iso_code %} disclosure__link--current{% endif %}"
                          {% if country.iso_code == localization.country.iso_code %}aria-current="true"{% endif %}
                          data-value="{{ country.iso_code }}">
                          {{ country.name }} <span class="localization-form__currency">({{ country.currency.iso_code }} {{ country.currency.symbol }})</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                  <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
                {%- endform -%}
              </disclosure-form>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if show_payment_icons -%}
          <div class="aldrich-footer__payment-types">
            <div class="sr-only">{{ 'sections.footer.payment' | t }}</div>
            <ul class="aldrich-footer__payment-list" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign show_credit_row = false
      if section.settings.credit_richtext != blank
        assign show_credit_row = true
      endif
      if section.settings.show_copyright
        assign show_credit_row = true
      endif
    -%}
    {%- if show_credit_row -%}
      <div class="aldrich-footer__row aldrich-footer__row--credit">
        {%- if section.settings.credit_richtext != blank -%}
          <div class="aldrich-footer__credit">{{ section.settings.credit_richtext }}</div>
        {%- endif -%}
        {%- if section.settings.show_copyright -%}
          <p class="aldrich-footer__credit">
            &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* Repeated verbatim from the header section so the footer stands on its own.
     The values are identical, so the order the stylesheets combine in is
     irrelevant. */
  .aldrich-container {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    padding-right: 16px;
    padding-left: 16px;
  }

  @media (min-width: 576px) {
    .aldrich-container { max-width: 768px; }
  }

  @media (min-width: 768px) {
    .aldrich-container { max-width: 1024px; }
  }

  @media (min-width: 1024px) {
    .aldrich-container { max-width: 1280px; }
  }

  @media (min-width: 1280px) {
    .aldrich-container { max-width: 1281px; }
  }

  .aldrich-footer {
    margin: 0 auto;
    max-width: var(--max-width-header);
    border-top: 1px solid #000000;
    background: var(--aldrich-background);
    color: var(--aldrich-body);
    font-family: var(--aldrich-sans);
    letter-spacing: var(--aldrich-tracking);
    font-size: 1rem;
    line-height: 1.6;
    padding-top: 2.5rem;
    /* The main site ends its footer with a deep gap below the credit line. Kept
       on the footer itself so it survives the credit row being switched off. */
    padding-bottom: 100px;
  }

  .aldrich-footer a {
    color: var(--aldrich-ink);
    text-decoration: none;
  }

  .aldrich-footer a:hover {
    text-decoration: underline;
  }

  .aldrich-footer strong {
    font-weight: 700;
  }

  .aldrich-footer__heading {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }

  .aldrich-footer__address,
  .aldrich-footer__stack {
    margin: 0;
    font-style: normal;
  }

  .aldrich-footer__address p,
  .aldrich-footer__newsletter-text p,
  .aldrich-footer__credit p {
    margin: 0;
  }

  /* Column grid, mirroring the main site's centred Bootstrap row ----------- */
  .aldrich-footer__columns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-right: -8px;
    margin-left: -8px;
  }

  .aldrich-footer__col {
    position: relative;
    flex: 0 0 100%;
    max-width: 100%;
    padding-right: 8px;
    padding-left: 8px;
  }

  .aldrich-footer__col + .aldrich-footer__col {
    margin-top: 1.5rem;
  }

  @media (min-width: 576px) {
    .aldrich-footer__col + .aldrich-footer__col { margin-top: 0; }

    .aldrich-footer__col--address,
    .aldrich-footer__col--newsletter {
      flex: 0 0 33.3333333333%;
      max-width: 33.3333333333%;
    }

    .aldrich-footer__col--social,
    .aldrich-footer__col--menu {
      flex: 0 0 25%;
      max-width: 25%;
    }
  }

  @media (min-width: 768px) {
    .aldrich-footer__col--address,
    .aldrich-footer__col--newsletter {
      flex: 0 0 25%;
      max-width: 25%;
    }

    .aldrich-footer__col--social,
    .aldrich-footer__col--menu {
      flex: 0 0 16.6666666667%;
      max-width: 16.6666666667%;
    }
  }

  @media (min-width: 1024px) {
    .aldrich-footer__col--address,
    .aldrich-footer__col--newsletter {
      flex: 0 0 16.6666666667%;
      max-width: 16.6666666667%;
    }

    .aldrich-footer__col--social,
    .aldrich-footer__col--menu {
      flex: 0 0 8.3333333333%;
      max-width: 8.3333333333%;
    }
  }

  /* Chevron mark under the address block */
  .aldrich-footer__chevron {
    display: block;
    margin-top: 1.5rem;
  }

  .aldrich-footer__chevron svg {
    display: block;
    width: 20%;
    height: auto;
    fill: var(--aldrich-ink);
  }

  @media (min-width: 576px) {
    .aldrich-footer__chevron {
      position: absolute;
      bottom: 0;
      left: 8px;
      right: 8px;
      margin-top: 0;
    }

    .aldrich-footer__chevron svg { width: 50%; }
  }

  /* Newsletter form ------------------------------------------------------- */
  .aldrich-form {
    font-family: var(--aldrich-mono);
    line-height: 1.6;
    letter-spacing: normal;
    font-size: 0.875rem;
  }

  .aldrich-form__group {
    max-width: 50vw;
    min-width: 150px;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  /* Every declaration below is spelled out, and selectors are deliberately
     two classes deep, because the theme styles bare `label` and `[type=email]`
     globally: it uppercases labels in the navigation font and puts a 2px border
     and 0.5rem/0.75rem padding on inputs. A single class ties on specificity
     with [type="email"], so it would win or lose on stylesheet order. */
  .aldrich-form .aldrich-form__group label {
    display: block;
    padding-bottom: 0;
    margin-bottom: 0;
    font-family: var(--aldrich-mono);
    font-size: inherit;
    line-height: inherit;
    text-transform: none;
    letter-spacing: normal;
    color: inherit;
  }

  .aldrich-form .aldrich-field {
    display: block;
    width: 100%;
    height: calc(1.5em + 0.5rem + 2px);
    padding: 0.25rem 0.5rem;
    font-family: var(--aldrich-mono);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--aldrich-field-ink);
    background-color: #fff;
    background-clip: padding-box;
    border: 1px solid var(--aldrich-field-border);
    border-radius: 0.2rem;
    box-shadow: none;
  }

  .aldrich-form .aldrich-field:focus {
    border-color: hsl(0, 0%, 25%);
    outline: 0;
    box-shadow: 0 0 0 0.2rem rgba(0, 0, 0, 0.25);
  }

  .aldrich-form .aldrich-button {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.75em 0.75rem;
    font-family: var(--aldrich-mono);
    font-size: 0.875rem;
    line-height: 1;
    color: #fff;
    text-align: center;
    text-decoration: none;
    text-transform: none;
    letter-spacing: normal;
    background-color: var(--aldrich-ink);
    border: 1px solid var(--aldrich-ink);
    border-radius: 0.25rem;
    cursor: pointer;
  }

  .aldrich-form .aldrich-button:hover {
    color: #fff;
    text-decoration: none;
  }

  .aldrich-form__honeypot {
    position: absolute;
    left: -5000px;
  }

  .aldrich-form__message:empty {
    display: none;
  }

  .aldrich-form__message {
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .aldrich-form__message a {
    text-decoration: underline;
  }

  .aldrich-form__message--error {
    color: #9d0000;
  }

  @media (min-width: 768px) {
    /* Labels inherit this; the inputs deliberately stay at 0.875rem, matching
       Bootstrap's .form-control-sm on the main site. */
    .aldrich-form { font-size: 0.75rem; }
    .aldrich-form .aldrich-button { font-size: 0.75rem; }
  }

  /* Rules and bottom rows ------------------------------------------------- */
  .aldrich-rule {
    box-sizing: content-box;
    height: 2px;
    margin: 1.5rem 0;
    background-color: var(--aldrich-rule);
    border: none;
  }

  .aldrich-rule--thin { height: 1px; }

  @media (min-width: 768px) {
    .aldrich-rule { height: 1px; }
  }

  .aldrich-footer__rule { display: block; }

  @media (min-width: 576px) {
    .aldrich-footer__rule { display: none; }
  }

  .aldrich-footer__row {
    margin-top: 1.5rem;
    text-align: center;
  }

  .aldrich-footer__inline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aldrich-footer__inline > li {
    display: inline-block;
  }

  .aldrich-footer__row--store {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .aldrich-footer__disclosures {
    display: flex;
    justify-content: center;
    gap: 1rem;
    font-family: var(--aldrich-mono);
    font-size: 0.75rem;
    letter-spacing: normal;
  }

  .aldrich-footer__payment-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    fill: currentColor;
  }

  .aldrich-footer__credit {
    margin: 0;
    font-size: 0.75rem;
  }

  .aldrich-footer__credit a {
    text-decoration: underline;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var ERROR_CLASS = 'aldrich-form__message--error';
    var EMAIL_PATTERN = /^[^\s@<>()[\]\\,;:"]+@[^\s@<>()[\]\\,;:"]+\.[^\s@<>()[\]\\,;:"]{2,}$/;
    var counter = 0;

    function report(target, text, isError) {
      if (!target) return;
      // Mailchimp's messages can contain markup. Strip the tags and set text
      // rather than innerHTML, so a third-party response can never inject nodes.
      target.textContent = String(text).replace(/<[^>]*>/g, '').trim();
      target.classList.toggle(ERROR_CLASS, !!isError);
    }

    // Mailchimp's post-json endpoint only answers over JSONP, using `c` as the
    // callback parameter.
    function submitViaJsonp(form, message) {
      var callbackName = 'aldrichNewsletterCallback' + counter++;
      var query = new URLSearchParams(new FormData(form)).toString();
      var separator = form.getAttribute('action').indexOf('?') === -1 ? '?' : '&';
      var script = document.createElement('script');

      function cleanUp() {
        delete window[callbackName];
        if (script.parentNode) script.parentNode.removeChild(script);
      }

      window[callbackName] = function (data) {
        cleanUp();
        var succeeded = data && data.result === 'success';
        report(message, (data && data.msg) || '', !succeeded);
      };

      script.onerror = function () {
        cleanUp();
        report(message, form.dataset.messageInvalid || 'Subscription failed.', true);
      };

      script.src = form.getAttribute('action') + separator + query + '&c=' + callbackName;
      document.head.appendChild(script);
    }

    document.addEventListener('submit', function (event) {
      if (!event.target.closest) return;
      var form = event.target.closest('[data-aldrich-newsletter]');
      if (!form) return;

      event.preventDefault();

      var message = form.querySelector('[data-aldrich-newsletter-message]');
      var emailField = form.querySelector('[data-aldrich-newsletter-email]');
      var email = emailField ? emailField.value.trim() : '';

      if (!EMAIL_PATTERN.test(email)) {
        report(message, form.dataset.messageInvalid || 'Invalid email address', true);
        if (emailField) emailField.focus();
        return;
      }

      submitViaJsonp(form, message);
    });
  })();
