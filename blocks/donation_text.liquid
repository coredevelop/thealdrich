{% assign uid = block.id | replace: '_', '' | downcase %}

{% style %}
  .donation-text-{{ uid }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .donation-text__inner-{{ uid }} {
    text-align: {{ block.settings.text_alignment }};
    color: {{ block.settings.text_color }};
  }

  .donation-text__eyebrow-{{ uid }} {
    margin: 0 0 8px;
    font-family: var(--heading-font-family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ block.settings.heading_color }};
  }

  .donation-text__heading-{{ uid }} {
    margin: 0 0 12px;
    font-family: var(--heading-font-family);
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 500;
    line-height: 1.3;
    color: {{ block.settings.heading_color }};
  }

  .donation-text__body-{{ uid }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
  }

  .donation-text__body-{{ uid }} > *:first-child {
    margin-top: 0;
  }

  .donation-text__body-{{ uid }} > *:last-child {
    margin-bottom: 0;
  }

  .donation-text__body-{{ uid }} a {
    color: inherit;
  }

  @media screen and (max-width: 749px) {
    .donation-text__heading-{{ uid }} {
      font-size: {{ block.settings.heading_size | times: 0.85 | round }}px;
    }
  }
{% endstyle %}

<div
  class="donation-text-{{ uid }} px-rail"
  {% if block.settings.anchor_id != blank %}id="{{ block.settings.anchor_id | handleize }}" style="scroll-margin-top: 80px;"{% endif %}
  {{ block.shopify_attributes }}
>
  <div class="donation-text__inner-{{ uid }} max-w-screen mx-auto">
    {% if block.settings.eyebrow != blank %}
      <p class="donation-text__eyebrow-{{ uid }}">{{ block.settings.eyebrow }}</p>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="donation-text__heading-{{ uid }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.body != blank %}
      <div class="donation-text__body-{{ uid }}">{{ block.settings.body }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Donation text",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small label above the heading. Leave blank to hide.",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to hide.",
      "default": "Make a Gift"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>Your support helps The Aldrich present bold contemporary art and education programs.</p>"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Optional. Lets the Fund tabs 'Overview' scroll here.",
      "default": "donation-overview"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Donation text"
    }
  ]
}
{% endschema %}
