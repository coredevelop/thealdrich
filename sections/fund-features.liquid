<style>
  [data-section-id="{{ section.id }}"] {
    --fund-image-gap: {{ section.settings.image_gap }}px;
    --fund-block-gap: {{ section.settings.block_gap }}px;
  }

  {%- if section.settings.section_padding == false -%}
    [data-section-id="{{ section.id }}"].fund-features {
      padding-top: 0;
      padding-bottom: 0;
      border-bottom: 0;
    }
  {%- endif -%}

  [data-section-id="{{ section.id }}"] .fund-features__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  [data-section-id="{{ section.id }}"] .fund-features__list {
    display: flex;
    flex-direction: column;
    gap: var(--fund-block-gap);
  }

  [data-section-id="{{ section.id }}"] .fund-feature__heading,
  [data-section-id="{{ section.id }}"] .fund-features__title {
    font-family: var(--heading-font-family);
    margin: 0 0 20px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.075rem;
  }

  [data-section-id="{{ section.id }}"] .fund-feature__body,
  [data-section-id="{{ section.id }}"] .fund-feature__body p {
    font-family: "Regular", "helvetica neue", helvetica, arial, sans-serif;
    letter-spacing: 0.075rem;
    font-size: 1.25rem;
    line-height: 1.6;
    color: #212529;
  }

  [data-section-id="{{ section.id }}"] .fund-feature__images {
    display: grid;
    gap: var(--fund-image-gap);
    margin-bottom: 24px;
  }

  [data-section-id="{{ section.id }}"] .fund-feature__image-wrap {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    overflow: hidden;
    line-height: 0;
    background-color: {{ section.settings.image_placeholder_color }};
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  [data-section-id="{{ section.id }}"] .fund-feature__gallery-trigger {
    cursor: zoom-in;
  }

  [data-section-id="{{ section.id }}"] .fund-feature__gallery-trigger:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  [data-section-id="{{ section.id }}"] .fund-feature__image-wrap img,
  [data-section-id="{{ section.id }}"] .fund-feature__image-wrap .placeholder-svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: {{ section.settings.image_ratio }};
    object-fit: cover;
  }

  [data-section-id="{{ section.id }}"] .fund-feature__link {
    display: inline-block;
    margin-top: 4px;
    font-family: "RegularBold", "helvetica neue", helvetica, arial, sans-serif;
    font-weight: 700;
    letter-spacing: 0.075rem;
    font-size: 1.25rem;
    line-height: 1.6;
    text-decoration: underline;
    text-underline-offset: 3px;
    color: inherit;
  }

  @media screen and (max-width: 749px) {
    [data-section-id="{{ section.id }}"] .fund-feature__images {
      grid-template-columns: 1fr !important;
    }
  }

</style>

{%- if section.settings.enable_image_gallery -%}
  {{ 'fund-gallery.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'fund-gallery.js' | asset_url }}" defer></script>
{%- endif -%}

<div
  class="fund-features px-rail py-section border-b border-primary-section-border"
  data-section-id="{{ section.id }}"
  data-section-type="fund-features"
  data-fund-gallery-root
>
  <div class="fund-features__inner max-w-screen mx-auto">
    {%- if section.settings.title != blank -%}
      <h2 class="fund-features__title text-2xl md:text-3xl pb-6">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="fund-features__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign image_count = 0
          if block.settings.image_1 != blank
            assign image_count = image_count | plus: 1
          endif
          if block.settings.image_2 != blank
            assign image_count = image_count | plus: 1
          endif
          if block.settings.image_3 != blank
            assign image_count = image_count | plus: 1
          endif
          assign column_count = image_count | at_least: 1
          assign img_sizes = '(max-width: 749px) 100vw, calc(100vw / ' | append: column_count | append: ')'
          if block.settings.anchor_id != blank
            assign fund_anchor = block.settings.anchor_id | handleize
          else
            assign fund_anchor = block.settings.heading | handleize
          endif
        -%}

        <div class="fund-feature" id="{{ fund_anchor }}" style="scroll-margin-top: {{ section.settings.scroll_margin_top }}px;" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3 class="fund-feature__heading text-xl md:text-2xl">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}

          {%- if image_count > 0 -%}
            <div
              class="fund-feature__images"
              style="grid-template-columns: repeat({{ column_count }}, 1fr);"
            >
              {%- assign gallery_position = 0 -%}
              {%- for i in (1..3) -%}
                {%- liquid
                  case i
                    when 1
                      assign fund_image = block.settings.image_1
                      assign fund_full_image = block.settings.full_image_1
                      assign fund_image_tooltip = block.settings.image_title_tooltip_1
                    when 2
                      assign fund_image = block.settings.image_2
                      assign fund_full_image = block.settings.full_image_2
                      assign fund_image_tooltip = block.settings.image_title_tooltip_2
                    when 3
                      assign fund_image = block.settings.image_3
                      assign fund_full_image = block.settings.full_image_3
                      assign fund_image_tooltip = block.settings.image_title_tooltip_3
                  endcase
                  assign fund_viewer_image = fund_full_image | default: fund_image
                -%}
                {%- if fund_image != blank -%}
                  {%- assign gallery_position = gallery_position | plus: 1 -%}
                  {%- capture fund_image_markup -%}
                    {{
                        fund_image
                        | image_url: width: 1200
                        | image_tag:
                          widths: '400, 600, 800, 1200',
                          sizes: img_sizes,
                          loading: 'lazy',
                          alt: fund_image.alt
                      }}
                  {%- endcapture -%}
                  {%- if section.settings.enable_image_gallery -%}
                    <button
                      type="button"
                      class="fund-feature__image-wrap fund-feature__gallery-trigger"
                      aria-label="Open image {{ gallery_position }} of {{ image_count }} for {{ block.settings.heading | escape }}"
                      aria-haspopup="dialog"
                      aria-controls="FundGallery-{{ section.id }}"
                      {% if fund_image_tooltip != blank %}title="{{ fund_image_tooltip | escape }}" {% endif %}
                      data-fund-gallery-trigger
                      data-fund-gallery-group="{{ block.id }}"
                      data-fund-gallery-src="{{ fund_viewer_image | image_url: width: 2400 }}"
                      data-fund-gallery-alt="{{ fund_viewer_image.alt | escape }}"
                      data-fund-gallery-caption="{{ fund_viewer_image.alt | default: block.settings.heading | escape }}"
                      data-fund-gallery-width="{{ fund_viewer_image.width }}"
                      data-fund-gallery-height="{{ fund_viewer_image.height }}"
                    >
                      {{ fund_image_markup }}
                    </button>
                  {%- else -%}
                    <div
                      class="fund-feature__image-wrap"
                      {% if fund_image_tooltip != blank %}title="{{ fund_image_tooltip | escape }}" {% endif %}
                    >
                      {{ fund_image_markup }}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if block.settings.body != blank -%}
            <div class="fund-feature__body rte space-y-4">{{ block.settings.body }}</div>
          {%- endif -%}

          {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
            <a class="fund-feature__link" href="{{ block.settings.link_url }}"><strong>{{ block.settings.link_label | escape }}</strong></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.enable_image_gallery -%}
    <fund-gallery>
      <dialog
        id="FundGallery-{{ section.id }}"
        class="fund-gallery"
        aria-label="Fund image gallery"
        data-fund-gallery-dialog
      >
        <div class="fund-gallery__surface" data-fund-gallery-surface>
          <span class="fund-gallery__counter" aria-live="polite" data-fund-gallery-counter></span>
          <button type="button" class="fund-gallery__close" aria-label="Close gallery" data-fund-gallery-close>&times;</button>
          <button type="button" class="fund-gallery__previous" aria-label="Previous image" data-fund-gallery-previous>&larr;</button>
          <figure class="fund-gallery__figure" data-fund-gallery-figure>
            <img class="fund-gallery__image" alt="" width="1" height="1" data-fund-gallery-image>
            <figcaption class="fund-gallery__caption" aria-live="polite" data-fund-gallery-caption></figcaption>
          </figure>
          <button type="button" class="fund-gallery__next" aria-label="Next image" data-fund-gallery-next>&rarr;</button>
        </div>
      </dialog>
    </fund-gallery>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Fund features",
  "class": "fund-features-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "section_padding",
      "label": "Add section padding",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "info": "Optional heading shown above all funds."
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content width",
      "info": "Maximum width of the funds content on large screens.",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "range",
      "id": "scroll_margin_top",
      "label": "Scroll offset",
      "info": "Space above each fund when scrolled to via the Fund tabs (match the tabs' sticky height).",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "checkbox",
      "id": "enable_image_gallery",
      "label": "Open images in gallery",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "3/2", "label": "Photo (3:2)" },
        { "value": "16/9", "label": "Wide (16:9)" }
      ],
      "default": "4/3"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "image_placeholder_color",
      "label": "Image placeholder color",
      "default": "#EEEEEE"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "block_gap",
      "label": "Gap between funds",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "fund",
      "name": "Fund",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Exhibitions Fund"
        },
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image 1"
        },
        {
          "type": "image_picker",
          "id": "full_image_1",
          "label": "Full image 1",
          "info": "Optional image used only in the full-screen viewer for Image 1."
        },
        {
          "type": "text",
          "id": "image_title_tooltip_1",
          "label": "Image Title Tooltip 1",
          "info": "Optional text shown when a customer hovers over Image 1."
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 2"
        },
        {
          "type": "image_picker",
          "id": "full_image_2",
          "label": "Full image 2",
          "info": "Optional image used only in the full-screen viewer for Image 2."
        },
        {
          "type": "text",
          "id": "image_title_tooltip_2",
          "label": "Image Title Tooltip 2",
          "info": "Optional text shown when a customer hovers over Image 2."
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image 3"
        },
        {
          "type": "image_picker",
          "id": "full_image_3",
          "label": "Full image 3",
          "info": "Optional image used only in the full-screen viewer for Image 3."
        },
        {
          "type": "text",
          "id": "image_title_tooltip_3",
          "label": "Image Title Tooltip 3",
          "info": "Optional text shown when a customer hovers over Image 3."
        },
        {
          "type": "header",
          "content": "Text"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text",
          "default": "<p>For 60 years, The Aldrich has offered first museum exhibitions for emerging or mid-career artists, first career surveys of underrepresented artists, and group exhibitions that offer unique perspectives on issues relevant to the world around us.</p><p>A gift to the Exhibitions Fund supports The Aldrich's significant curatorial program, which allows artists to create deep and insightful exhibitions and projects that will have a lasting impact within the field and the world beyond.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "info": "Leave blank to hide the link.",
          "default": "Read more about the Exhibitions Fund here."
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "anchor_id",
          "label": "Anchor ID",
          "info": "Optional. Used by the Fund tabs to scroll here. Defaults to a slug of the heading."
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Fund features",
      "blocks": [
        { "type": "fund" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
