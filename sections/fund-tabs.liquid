{%- assign uid = section.id | replace: '-', '' | replace: '_', '' | downcase -%}

<style>
  {%- if section.settings.sticky -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: 20;
      background-color: var(--primary-background-color, #fafafa);
    }
  {%- endif -%}

  [data-section-id="{{ section.id }}"] .fund-tabs__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 32px;
    justify-content: {{ section.settings.alignment }};
    padding: 14px 0;
    margin: 0 auto;
    max-width: {{ section.settings.content_max_width }}px;
    border-top: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  [data-section-id="{{ section.id }}"] .fund-tabs__link {
    background: none;
    border: 0;

    cursor: pointer;
    font-family: "ApercuPro", "helvetica neue", helvetica, arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.075rem;
    text-transform: uppercase;
    color: #000;
    transition: opacity 0.15s ease;
    padding: .25em .5625em .125em .5625em;
    text-decoration: none;
  }

  [data-section-id="{{ section.id }}"] .fund-tabs__link:hover {
    opacity: 1;

  }

  [data-section-id="{{ section.id }}"] .fund-tabs__link.is-active {
    opacity: 1;
    background-color: rgb(255, 225, 0);
    text-decoration: none;

  }

  @media screen and (max-width: 749px) {
    [data-section-id="{{ section.id }}"] .fund-tabs__nav {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
    }

    [data-section-id="{{ section.id }}"] .fund-tabs__link {
      flex: 0 0 auto;
      white-space: nowrap;
    }
  }
</style>

<div
  class="fund-tabs px-rail"
  data-section-id="{{ section.id }}"
  data-section-type="fund-tabs"
>
  <nav class="fund-tabs__nav" aria-label="{{ section.settings.aria_label | escape }}">
    <fund-tabs-{{ uid }}
      style="display: contents;"
      data-offset="{{ section.settings.scroll_offset }}"
      data-scroll-spy="{% if template.suffix == 'donation' or template.suffix == 'membership' or template.suffix == 'memebership' %}true{% else %}false{% endif %}"
    >
      {%- for block in section.blocks -%}
        {%- assign target = block.settings.target | strip | downcase -%}
        <a
          class="fund-tabs__link{% if block.settings.label == 'Overview' %} is-active{% endif %}"
          href="#{{ target }}"
          data-tab-target="{{ target }}"
          {{ block.shopify_attributes }}
        >{{ block.settings.label | escape }}</a>
      {%- endfor -%}
    </fund-tabs-{{ uid }}>
  </nav>
</div>

<script>
  (function() {
    class FundTabs{{ uid }} extends HTMLElement {
      connectedCallback() {
        this.offset = parseInt(this.dataset.offset, 10) || 0;
        this.nav = this.closest('.fund-tabs__nav');
        this.links = Array.from(this.querySelectorAll('[data-tab-target]'));
        this.linkHandlers = this.links.map((link) => {
          const handler = (event) => this.handleClick(event, link);
          link.addEventListener('click', handler);
          return { link, handler };
        });

        if (this.dataset.scrollSpy !== 'true') return;

        this.handleViewportChange = () => this.scheduleActiveUpdate();
        this.handleResize = () => {
          this.activeLink = null;
          this.scheduleActiveUpdate();
        };
        window.addEventListener('scroll', this.handleViewportChange, { passive: true });
        window.addEventListener('resize', this.handleResize);

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', this.handleViewportChange, { once: true });
        } else {
          this.updateActiveFromScroll();
        }
      }

      disconnectedCallback() {
        if (this.handleViewportChange) {
          window.removeEventListener('scroll', this.handleViewportChange);
          window.removeEventListener('resize', this.handleResize);
          document.removeEventListener('DOMContentLoaded', this.handleViewportChange);
        }
        this.linkHandlers.forEach(({ link, handler }) => {
          link.removeEventListener('click', handler);
        });

        if (this.activeUpdateFrame) {
          window.cancelAnimationFrame(this.activeUpdateFrame);
        }
      }

      scheduleActiveUpdate() {
        if (this.activeUpdateFrame) return;

        this.activeUpdateFrame = window.requestAnimationFrame(() => {
          this.activeUpdateFrame = null;
          this.updateActiveFromScroll();
        });
      }

      updateActiveFromScroll() {
        const targets = this.links.map((link) => ({
          link,
          element: document.getElementById(link.dataset.tabTarget)
        })).filter((item) => item.element);
        let activeLink = targets[0]?.link || this.links[0];
        const activationLine = window.pageYOffset + this.offset + 1;

        targets.forEach(({ link, element }) => {
          const targetTop = element.getBoundingClientRect().top + window.pageYOffset;
          if (targetTop <= activationLine) activeLink = link;
        });

        if (activeLink) this.setActiveLink(activeLink);
      }

      setActiveLink(activeLink) {
        const activeChanged = this.activeLink !== activeLink;

        this.links.forEach((link) => {
          const isActive = link === activeLink;
          link.classList.toggle('is-active', isActive);
          if (isActive) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        });

        this.activeLink = activeLink;
        if (activeChanged) this.keepActiveLinkVisible(activeLink);
      }

      keepActiveLinkVisible(activeLink) {
        if (!this.nav || !window.matchMedia('(max-width: 749px)').matches) return;

        const navRect = this.nav.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        const edgePadding = 8;
        let scrollDelta = 0;

        if (linkRect.left < navRect.left + edgePadding) {
          scrollDelta = linkRect.left - navRect.left - edgePadding;
        } else if (linkRect.right > navRect.right - edgePadding) {
          scrollDelta = linkRect.right - navRect.right + edgePadding;
        }

        if (scrollDelta !== 0) {
          this.nav.scrollBy({ left: scrollDelta, behavior: 'smooth' });
        }
      }

      handleClick(event, link) {
        const id = link.dataset.tabTarget;
        const targetEl = id ? document.getElementById(id) : null;
        if (!targetEl) return;

        event.preventDefault();
        const top = targetEl.getBoundingClientRect().top + window.pageYOffset - this.offset;
        window.scrollTo({ top: top, behavior: 'instant' });
        this.setActiveLink(link);
      }
    }

    if (!customElements.get('fund-tabs-{{ uid }}')) {
      customElements.define('fund-tabs-{{ uid }}', FundTabs{{ uid }});
    }
  })();
</script>

{% schema %}
{
  "name": "Fund tabs",
  "class": "fund-tabs-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Each tab scrolls to an element whose anchor ID matches the tab's target. Fund sections auto-generate anchor IDs from their headings (e.g. 'Exhibitions Fund' -> 'exhibitions-fund')."
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to top when scrolling",
      "default": false
    },
    {
      "type": "range",
      "id": "scroll_offset",
      "label": "Scroll offset",
      "info": "Pixels to offset the scroll target (use if a sticky header covers the top).",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content width",
      "min": 480,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Fund navigation"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Overview"
        },
        {
          "type": "text",
          "id": "target",
          "label": "Target anchor ID",
          "info": "The id of the element to scroll to, e.g. 'exhibitions-fund'.",
          "default": "donation-overview"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Fund tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Overview", "target": "donation-overview" } },
        { "type": "tab", "settings": { "label": "Exhibitions Fund", "target": "exhibitions-fund" } },
        { "type": "tab", "settings": { "label": "Education Fund", "target": "education-fund" } },
        { "type": "tab", "settings": { "label": "Annual Fund", "target": "annual-fund" } },
        { "type": "tab", "settings": { "label": "Sculpture Garden Fund", "target": "sculpture-garden-fund" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
